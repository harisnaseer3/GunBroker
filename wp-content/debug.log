<td>9mm</td>
</tr>
<tr>
<td><strong>Barrel Length</strong></td>
<td>4.5&#8243;</td>
</tr>
<tr>
<td><strong>Overall Length</strong></td>
<td>8&#8243;</td>
</tr>
<tr>
<td><strong>Weight</strong></td>
<td>23.9 oz</td>
</tr>
<tr>
<td><strong>Capacity</strong></td>
<td>17+1 / 20+1</td>
</tr>
<tr>
<td><strong>Sights</strong></td>
<td>Tritium / Luminescent Front, Tactical Rack U-Dot™ Rear</td>
</tr>
<tr>
<td><strong>Finish</strong></td>
<td>Melonite</td>
